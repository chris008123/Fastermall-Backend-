// ── ADD THIS to the bottom of your existing prisma/schema.prisma ──
// (Support tickets — not in the original schema, needed for the Support module)

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("support_tickets")
}
