generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String?         @unique
  phone          String?         @unique
  passwordHash   String?
  googleId       String?         @unique
  fullName       String
  isVerified     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  otpCodeHash    String?
  otpExpiresAt   DateTime?
  otpAttempts    Int             @default(0)
  resetCodeHash  String?
  resetExpiresAt DateTime?
  resetAttempts  Int             @default(0)
  // Per-account lockout after repeated wrong passwords or codes.
  loginFailures  Int             @default(0)
  loginLockedUntil DateTime?
  codeFailures   Int             @default(0)
  codeLockedUntil DateTime?
  laundryOrders  LaundryOrder[]
  notifications  Notification[]
  devices        Device[]
  orders         Order[]
  supportTickets SupportTicket[]
  // Set when the customer deletes their account. The row is kept (orders
  // reference it) but every personal field is cleared.
  deletedAt      DateTime?
  reviews        ProductReview[]
  addresses      Address[]

  @@map("users")
}

model StaffUser {
  id                  String                  @id @default(uuid())
  email               String?                 @unique
  phone               String?                 @unique
  passwordHash        String
  fullName            String
  role                StaffRole
  isVerified          Boolean                 @default(false)
  // Deactivated accounts can't sign in, and their existing tokens are refused.
  isActive            Boolean                 @default(true)
  deactivatedAt       DateTime?
  // Login lockout and self-service password reset (see StaffService).
  failedLoginAttempts Int                     @default(0)
  lockedUntil         DateTime?
  resetCodeHash       String?
  resetExpiresAt      DateTime?
  resetAttempts       Int                     @default(0)
  // Added by migration 20261017130000_account_lockout but never used: staff
  // lockout uses failedLoginAttempts / lockedUntil above.
  loginFailures       Int                     @default(0)
  loginLockedUntil    DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  sessions            StaffSession[]
  deliveryProfile     DeliveryPartnerProfile?
  notifications       Notification[]
  devices             Device[]
  claimedDeliveries   Delivery[]
  ticketReplies       SupportTicketReply[]
  supportTickets      SupportTicket[]
  ownedVendors        FoodVendor[]            @relation("VendorOwner")

  @@map("staff_users")
}

// Remembers the result of an action sent with an Idempotency-Key header, so a
// retry (after a timeout, say) gets the first result back instead of running
// the action twice. Rows older than 24 hours are ignored and cleaned up.
model IdempotencyKey {
  id          String    @id @default(uuid())
  staffUserId String
  key         String
  fingerprint String
  response    Json?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([staffUserId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// One row per signed-in device. The access token carries this id (`sid`), so
// logging out or disabling the account ends the session straight away.
model StaffSession {
  id               String    @id @default(uuid())
  staffUserId      String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?
  staffUser        StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@map("staff_sessions")
}

model DeliveryPartnerProfile {
  id           String              @id @default(uuid())
  staffUserId  String              @unique
  type         DeliveryPartnerType
  isAvailable  Boolean             @default(false)
  currentLat   Float?
  currentLng   Float?
  // Only the latest position is kept (no trail), and it is cleared when the
  // partner goes offline. See PresenceService.
  locationAt        DateTime?
  locationAccuracyM Float?
  lastSeenAt        DateTime?
  vehiclePlate String?
  // Where cash-outs are sent (mobile money). Only the masked number is ever
  // returned by the API.
  payoutNetwork String?
  payoutNumber  String?
  // Saved app settings (notifications, delivery, navigation). See PreferencesService.
  preferences   Json?
  documents     PartnerDocument[]
  createdAt    DateTime            @default(now())
  payoutRequests PayoutRequest[]
  deliveries   Delivery[]
  staffUser    StaffUser           @relation(fields: [staffUserId], references: [id])
  earnings     DriverEarning[]
  payouts      PartnerPayout[]

  @@map("delivery_partner_profiles")
}

model Category {
  id       String    @id @default(uuid())
  name     String
  icon     String?
  products Product[]

  @@map("categories")
}

model MarketplaceVendor {
  id       String    @id @default(uuid())
  name     String
  location String?
  isActive Boolean   @default(true)
  products Product[]

  @@map("marketplace_vendors")
}

model Product {
  id          String             @id @default(uuid())
  name        String
  description String?
  price       Decimal            @db.Decimal(10, 2)
  stock       Int                @default(0)
  categoryId  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  imageUrl    String?
  unit        String?
  vendorId    String?
  orderItems  OrderItem[]
  category    Category?          @relation(fields: [categoryId], references: [id])
  vendor      MarketplaceVendor? @relation(fields: [vendorId], references: [id])
  // Average of the product's reviews (1-5), null until the first review.
  // Kept up to date when a review is written or removed, so listings can
  // sort and filter on it.
  rating      Float?
  reviewCount Int                @default(0)
  reviews     ProductReview[]
  // Photos in display order. imageUrl above is always the first one (or
  // null), so apps that only read imageUrl keep working.
  images      ProductImage[]

  @@map("products")
}

model FoodCategory {
  id        String   @id @default(uuid())
  name      String
  icon      String?
  service   String   @default("food")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("food_categories")
}

model FoodVendor {
  id              String     @id @default(uuid())
  name            String
  location        String?
  isActive        Boolean    @default(true)
  categoryIds     String[]
  deliveryFee     Decimal    @default(0) @db.Decimal(10, 2)
  deliveryTimeMin Int        @default(30)
  description     String?
  imageUrl        String?
  minOrder        Decimal    @default(0) @db.Decimal(10, 2)
  rating          Float      @default(0)
  reviewCount     Int        @default(0)
  isOpen          Boolean    @default(true)
  // The VENDOR staff account that runs this vendor's menu.
  ownerStaffId    String?
  owner           StaffUser? @relation("VendorOwner", fields: [ownerStaffId], references: [id], onDelete: SetNull)
  menuItems       MenuItem[]

  @@index([ownerStaffId])
  @@map("food_vendors")
}

model MenuItem {
  id          String      @id @default(uuid())
  vendorId    String
  name        String
  price       Decimal     @db.Decimal(10, 2)
  isAvailable Boolean     @default(true)
  category    String?
  description String?
  imageUrl    String?
  rating      Float       @default(0)
  vendor      FoodVendor  @relation(fields: [vendorId], references: [id])
  orderItems  OrderItem[]

  @@map("menu_items")
}

model Order {
  id             String      @id @default(uuid())
  customerId     String
  type           OrderType
  status         OrderStatus @default(PENDING)
  totalAmount    Decimal     @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  addressLabel   String?
  deliveryFee    Decimal     @default(0) @db.Decimal(10, 2)
  notes          String?
  paymentMethod  String?
  vendorName     String?
  delivery       Delivery?
  items          OrderItem[]
  customer       User        @relation(fields: [customerId], references: [id])
  payment        Payment?
  // Sent by the app as the Idempotency-Key header so a retried request
  // returns the first order instead of creating a second one.
  idempotencyKey String?
  // Marketplace delivery window (see src/shared/utils/delivery-windows.ts).
  // Assigned from the order time; the customer may move it to one of the two
  // windows after the original one. Null for food orders and for orders
  // placed before windows existed.
  deliveryWindowStart DateTime?
  deliveryWindowEnd   DateTime?
  originalWindowStart DateTime?
  rescheduledAt       DateTime?
  rescheduleCount     Int       @default(0)

  @@unique([customerId, idempotencyKey])
  @@index([deliveryWindowStart])
  @@map("orders")
}

model OrderItem {
  id         String    @id @default(uuid())
  orderId    String
  productId  String?
  menuItemId String?
  quantity   Int
  unitPrice  Decimal   @db.Decimal(10, 2)
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])
  order      Order     @relation(fields: [orderId], references: [id])
  product    Product?  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model LaundryCatalogItem {
  id          String        @id @default(uuid())
  name        String
  description String?
  unitPrice   Decimal       @db.Decimal(10, 2)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       LaundryItem[]

  @@map("laundry_catalog_items")
}

model LaundryOrder {
  id         String @id @default(uuid())
  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  status LaundryStatus @default(PICKUP_REQUESTED)

  instructions String?

  pickupMode String?
  pickupAt   DateTime?
  deliverAt  DateTime?

  estimatedKg  Decimal? @db.Decimal(10, 2)
  laundryTotal Decimal? @db.Decimal(10, 2)
  deliveryFee  Decimal  @default(0) @db.Decimal(10, 2)

  totalAmount Decimal @db.Decimal(10, 2)

  items    LaundryItem[]
  payment  Payment?
  delivery Delivery?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Hostel / room / landmark the rider collects the bag from.
  addressLabel   String?
  idempotencyKey String?

  @@unique([customerId, idempotencyKey])
  @@map("laundry_orders")
}

model LaundryItem {
  id             String              @id @default(uuid())
  laundryOrderId String
  description    String
  tagCode        String?
  catalogItemId  String?
  lineTotal      Decimal?            @db.Decimal(10, 2)
  quantity       Int                 @default(1)
  unitPrice      Decimal?            @db.Decimal(10, 2)
  catalogItem    LaundryCatalogItem? @relation(fields: [catalogItemId], references: [id])
  laundryOrder   LaundryOrder        @relation(fields: [laundryOrderId], references: [id])

  @@map("laundry_items")
}

model Delivery {
  id                      String                  @id @default(uuid())
  orderId                 String?                 @unique
  laundryOrderId          String?                 @unique
  partnerId               String?
  status                  DeliveryStatus          @default(ASSIGNED)
  pickupLat               Float?
  pickupLng               Float?
  dropoffLat              Float?
  dropoffLng              Float?
  distanceKm              Float?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  deliveryCodeAttempts    Int                     @default(0)
  deliveryCodeHash        String?
  deliveryCodeLockedUntil DateTime?
  deliveryCodeUsed        Boolean                 @default(false)
  verifiedAt              DateTime?
  deliveryCodeEncrypted   String?
  laundryOrder            LaundryOrder?           @relation(fields: [laundryOrderId], references: [id])
  order                   Order?                  @relation(fields: [orderId], references: [id])
  partner                 DeliveryPartnerProfile? @relation(fields: [partnerId], references: [id])
  // Marketplace and laundry deliveries are run by admins, who have no partner
  // profile. This records which admin accepted the delivery.
  claimedByStaffId        String?
  claimedBy               StaffUser?              @relation(fields: [claimedByStaffId], references: [id])
  statusEvents            DeliveryStatusEvent[]
  // Last position reported by the rider (partner or admin) while the
  // delivery is in progress. Shown on the customer's tracking map.
  riderLat                Float?
  riderLng                Float?
  riderLocationAt         DateTime?

  supportTickets          SupportTicket[]

  @@index([claimedByStaffId])
  @@map("deliveries")
}

// One row each time a delivery moves to a new stage, so the app can show when it happened.
model DeliveryStatusEvent {
  id         String         @id @default(uuid())
  deliveryId String
  status     DeliveryStatus
  createdAt  DateTime       @default(now())
  delivery   Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
  @@map("delivery_status_events")
}

enum DocumentType {
  ID_CARD
  PROFILE_PHOTO
  DRIVERS_LICENSE
  VEHICLE_REGISTRATION
  INSURANCE
}

enum DocumentStatus {
  UPLOADING
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

// A verification document a partner uploaded (ID, licence...). The file lives
// in private storage; only its path is stored here, and the path is never sent
// to the partner app.
model PartnerDocument {
  id              String                 @id @default(uuid())
  partnerId       String
  type            DocumentType
  status          DocumentStatus         @default(UPLOADING)
  storagePath     String
  contentType     String
  sizeBytes       Int
  expiresAt       DateTime?
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  partner         DeliveryPartnerProfile @relation(fields: [partnerId], references: [id])

  @@index([partnerId, type])
  @@index([status, createdAt])
  @@map("partner_documents")
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

// A partner's request to cash out. Money is whole pesewas (1 GHS = 100), never
// a floating-point number. PENDING and PAID count against the balance; FAILED
// gives the money back.
model PayoutRequest {
  id                String                 @id @default(uuid())
  partnerId         String
  amountPesewas     Int
  feePesewas        Int                    @default(0)
  currency          String                 @default("GHS")
  status            PayoutStatus           @default(PENDING)
  network           String
  destinationNumber String
  destinationMasked String
  failureReason     String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  partner           DeliveryPartnerProfile @relation(fields: [partnerId], references: [id])

  @@index([partnerId, createdAt])
  @@index([status, createdAt])
  @@map("payout_requests")
}

model DriverEarning {
  id        String                 @id @default(uuid())
  partnerId String
  amount    Decimal                @db.Decimal(10, 2)
  note      String?
  createdAt DateTime               @default(now())
  partner   DeliveryPartnerProfile @relation(fields: [partnerId], references: [id])

  @@map("driver_earnings")
}

// Money actually paid out to a partner (recorded by an admin after sending
// it, e.g. by mobile money). Balance = sum(earnings) - sum(payouts).
model PartnerPayout {
  id          String                 @id @default(uuid())
  partnerId   String
  amount      Decimal                @db.Decimal(10, 2)
  method      String                 @default("MOBILE_MONEY")
  reference   String?
  note        String?
  createdById String
  createdAt   DateTime               @default(now())
  partner     DeliveryPartnerProfile @relation(fields: [partnerId], references: [id])

  @@index([partnerId, createdAt])
  @@map("partner_payouts")
}

// Editable platform settings, one row per key. Missing keys use the
// defaults in src/modules/settings/settings.service.ts.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

// Every successful change an admin makes through the API. Staff id and name
// are copied so the record survives the account being removed.
model AdminAuditLog {
  id         String   @id @default(uuid())
  staffId    String
  staffName  String?
  action     String
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([staffId, createdAt])
  @@map("admin_audit_logs")
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String?       @unique
  laundryOrderId String?       @unique
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  providerRef    String?
  reference      String?       @unique
  provider       String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  laundryOrder   LaundryOrder? @relation(fields: [laundryOrderId], references: [id])
  order          Order?        @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Notification {
  id          String     @id @default(uuid())
  userId      String?
  staffUserId String?
  title       String
  body        String
  type        String     @default("GENERAL")
  data        Json?
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  user        User?      @relation(fields: [userId], references: [id], onDelete: Restrict)
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([staffUserId, createdAt])
  @@map("notifications")
}

// Expo push tokens. A device belongs to exactly one owner: a customer (User)
// or a staff member (StaffUser). The token is unique, so logging in with a
// different account on the same phone moves the token to the new owner.
model Device {
  id            String     @id @default(uuid())
  token         String     @unique
  platform      String
  userId        String?
  staffUserId   String?
  lastSeenAt    DateTime   @default(now())
  createdAt     DateTime   @default(now())
  user          User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffUser     StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  // Per-category push switches from the app. The in-app list still
  // gets every notification; these only stop the lock-screen push.
  orderUpdates  Boolean    @default(true)
  announcements Boolean    @default(true)

  @@index([userId])
  @@index([staffUserId])
  @@map("devices")
}

// A support request from a customer (userId) or a staff member such as a
// delivery partner (staffUserId), optionally about one delivery.
model SupportTicket {
  id          String               @id @default(uuid())
  // Exactly one of userId (a customer) or staffUserId (e.g. a partner).
  userId      String?
  staffUserId String?
  // Optional: the delivery this ticket is about (must be the owner's own).
  deliveryId  String?
  subject     String
  message     String
  status      TicketStatus         @default(OPEN)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User?                @relation(fields: [userId], references: [id], onDelete: Restrict)
  staffUser   StaffUser?           @relation(fields: [staffUserId], references: [id])
  delivery    Delivery?            @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  // Optional: what a "Report a problem" ticket is about.
  targetType  String?
  targetId    String?
  reason      String?
  replies     SupportTicketReply[]

  @@index([userId, createdAt])
  @@index([staffUserId, createdAt])
  @@index([status, createdAt])
  @@map("support_tickets")
}

// A message on a ticket after the first one (which stays on the ticket
// itself). Written by support (fromAdmin, staffUserId = the admin) or by the
// ticket's owner (fromAdmin false, authorId = the customer or staff member).
model SupportTicketReply {
  id          String        @id @default(uuid())
  ticketId    String
  staffUserId String?
  fromAdmin   Boolean       @default(true)
  authorId    String?
  message     String
  createdAt   DateTime      @default(now())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  staffUser   StaffUser?    @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_ticket_replies")
}

enum StaffRole {
  VENDOR
  DELIVERY_PARTNER
  LAUNDRY_STAFF
  ADMIN
}

enum DeliveryPartnerType {
  WALKING
  MOTORCYCLE
}

enum OrderType {
  MARKETPLACE
  FOOD
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum LaundryStatus {
  PICKUP_REQUESTED
  RECEIVED
  INSPECTED
  TAGGED
  WASHING
  DRYING
  IRONING
  FOLDING
  QUALITY_CHECK
  PACKAGED
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  COMPLETED
}

enum DeliveryStatus {
  ASSIGNED
  EN_ROUTE_TO_PICKUP
  PAY_VENDOR
  PICKED_UP
  EN_ROUTE_TO_CUSTOMER
  DELIVERED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MOBILE_MONEY
  CARD
  CASH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// One review per customer per product. Writing again edits it.
model ProductReview {
  id        String   @id @default(uuid())
  productId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, createdAt])
  @@map("product_reviews")
}

// A customer's saved delivery address. At most one per customer is the default.
model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String
  hostel    String
  room      String
  landmark  String?
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// A Frequently Asked Question shown in the apps (GET /faqs). Admins manage
// them; only published ones are shown. Ordered by category, then sortOrder.
model Faq {
  id          String   @id @default(uuid())
  question    String
  answer      String
  category    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, category, sortOrder])
  @@map("faqs")
}

// A product photo stored in the public product-images bucket.
model ProductImage {
  id          String   @id @default(uuid())
  productId   String
  // Public URL the apps load.
  url         String
  // Path inside the bucket, used to delete the file.
  path        String
  contentType String
  sizeBytes   Int
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}
