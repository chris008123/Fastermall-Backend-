# NEVER put real secrets in this file — it is committed to git. Copy it to
# .env (which is gitignored) locally, and set the real values in Render.

# App
PORT=3000
NODE_ENV=development

# Supabase Postgres (Project Settings -> Database -> Connection string)
# Use the "Transaction" pooler URL for DATABASE_URL and the direct connection for DIRECT_URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase project (used for storage / optional supabase-js features, not for auth by default)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Auth (we issue our own JWTs from the Identity module)
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production if this is shorter than 32 characters.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Delivery codes are stored encrypted. 64 hex characters (32 bytes).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DELIVERY_CODE_ENCRYPTION_KEY=replace-with-64-hex-characters

# One-time secret for creating the very first admin account
ADMIN_BOOTSTRAP_SECRET=replace-me

# Email (sign-up and password-reset codes)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me

# Payments. 'paystack' for real payments; 'mock' is for local development only
# and is refused when NODE_ENV=production.
PAYMENT_PROVIDER=paystack
PAYMENT_CURRENCY=GHS
PAYSTACK_SECRET_KEY=sk_test_replace-me
# Where Paystack sends the customer's browser after checkout (this API's callback route):
PAYMENT_CALLBACK_URL=https://YOUR-RENDER-APP.onrender.com/api/v1/payments/callback

# Optional: comma-separated browser origins allowed to call the API.
# The mobile app is not affected. Leave empty to allow any origin (not recommended in production).
CORS_ORIGINS=
