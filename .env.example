# App
PORT=3000
NODE_ENV=development

# Supabase Postgres (Project Settings -> Database -> Connection string)
# Use the "Transaction" pooler URL for DATABASE_URL and the direct connection for DIRECT_URL
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase project (used for storage / optional supabase-js features, not for auth by default)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Auth (we issue our own JWTs from the Identity module; see README for why)
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
